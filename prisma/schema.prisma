datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Quiz {
  id            Int      @id @default(autoincrement())
  topic         String
  question      String
  options       Option[]
  correctAnswer String
  explanation   String?
  createdAt     DateTime @default(now())
}

model Option {
  id     Int    @id @default(autoincrement())
  text   String
  quizId Int
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model User {
  id          Int         @id @default(autoincrement())
  name        String
  email       String      @unique
  password    String
  createdAt   DateTime    @default(now())
  scores      QuizScore[] // <--- Add this line inside your User model!
}

model QuizScore {
  id        Int      @id @default(autoincrement())
  topic     String   // e.g., "Algebra", "Statistics"
  score     Int      // Number of correct answers
  total     Int      // Total questions in the quiz
  createdAt DateTime @default(now())
  
  // Foreign Key to link this score to a specific User
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}